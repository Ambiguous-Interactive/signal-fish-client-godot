# GDLint config (gdtoolkit 4.5.0). Unlisted checks use gdlint defaults;
# see `gdlint -d` for the full dump.
#
# max-public-methods: the SignalFishClient public API is plan-mandated
# (PLAN.md §4.2): 15 lifecycle/state accessors plus 11 protocol/lifecycle send
# methods (reconnect + set_auto_reconnect landed with P2 reconnection;
# send_game_data_binary ships with the P2 binary milestone) intentionally
# exceed the default of 20. get_authority_player joined with issue #147 so
# games read the authority off the client instead of tracking a signal.
# get_supports_authority joined with issue #338 so the Steam bootstrap reads
# the room's authority flag off the client instead of tracking baselines.
max-public-methods: 32

# max-file-lines: the headless test runners are single-file SceneTree scripts
# with table-driven cases; the limit keeps each transport area in one runner
# (raised to 1250 when the largest runner crossed 1200, to 1320 when the
# client gained the PLAN §4.7 heartbeat and its suites, to 1400 when every
# test gained the issue-#104 completion sentinel, to 1450 when the client
# gained the issue-#147 authority-flag cache and accessor) without inviting
# unbounded growth. 1450 -> 1550: the addon joined the error-level warning
# net (exclude_addons=false, issue #170) and carries per-statement
# @warning_ignore markers; the client alone holds 58 of them.
# 1550 -> 1600: the client gained the issue-#333 outbound frame-cap gates.
# 1600 -> 1620: the client gained the issue-#341 dial-deadline window.
# 1620 -> 1640: the client gained the issue-#338 authority-flag accessor.
max-file-lines: 1640

# max-returns: the headless smoke runner sequences async waits with
# early-return guards so a timed-out step skips every dependent step; the
# echo phase needs 8 returns for that chain (see tests/smoke).
max-returns: 8
