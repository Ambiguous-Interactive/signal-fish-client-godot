# GDLint config (gdtoolkit 4.5.0). Unlisted checks use gdlint defaults;
# see `gdlint -d` for the full dump.
#
# max-public-methods: the SignalFishClient public API is plan-mandated
# (PLAN.md §4.2): 15 lifecycle/state accessors plus 11 protocol/lifecycle send
# methods (reconnect + set_auto_reconnect landed with P2 reconnection;
# send_game_data_binary ships with the P2 binary milestone) intentionally
# exceed the default of 20.
max-public-methods: 30

# max-file-lines: the headless test runners are single-file SceneTree scripts
# with table-driven cases; 1250 keeps each transport area in one runner (the
# unsafe-access typing sweep added mandatory annotations and the largest
# runner crossed 1200) without inviting unbounded growth.
max-file-lines: 1250

# max-returns: the headless smoke runner sequences async waits with
# early-return guards so a timed-out step skips every dependent step; the
# echo phase needs 8 returns for that chain (see tests/smoke).
max-returns: 8
