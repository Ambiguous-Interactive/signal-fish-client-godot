#!/usr/bin/env sh
# Minimal POSIX shim. All real logic lives in scripts/run-llm-hooks.ps1
# so it can be invoked identically from sh-capable systems (Linux, macOS,
# Git for Windows / Git Bash) and from PowerShell-only environments via
# `.githooks/pre-commit.ps1`. Keeping logic out of this file prevents the
# generator and lint flow from drifting between platforms.
set -eu

if ! command -v pwsh >/dev/null 2>&1; then
  echo "[llm-hook] ERROR: pwsh (PowerShell 7+) is required to run the LLM harness hooks." >&2
  echo "[llm-hook] Install from https://aka.ms/powershell and re-run the commit." >&2
  exit 1
fi

# Resolve repo root from the hook script location so the hook works regardless
# of the caller's cwd.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"

exec pwsh -NoProfile -File "$REPO_ROOT/scripts/run-llm-hooks.ps1" -AutoFix
