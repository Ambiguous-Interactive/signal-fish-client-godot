# Repository line-ending normalization.
# Ensures shell scripts always have LF endings even when committed from
# Windows hosts, so they remain executable inside the Linux dev container.

* text=auto eol=lf

# Shell / config — must be LF
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# PowerShell stays CRLF unless a shebang makes direct Unix execution possible.
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf

# PowerShell files with shebangs must stay LF; otherwise Unix may look for
# an interpreter named "pwsh\r" when a script is executed directly.
.claude/hooks/*.ps1 text eol=lf
.githooks/*.ps1     text eol=lf

# Godot resources are text but stay as-is to match upstream tooling
*.gd        text eol=lf
*.tres      text eol=lf
*.tscn      text eol=lf
*.gdshader  text eol=lf
*.import    text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.xz        binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

# Dev/test-only paths stay out of git archives (Asset Library downloads a
# ref-generated archive; the addon must stay self-contained under addons/).
# Users get the addon, the runnable demo (+ project.godot), and
# LICENSE/README/CHANGELOG; everything else (agent instruction files,
# tooling config, CI requirements) is excluded so the download is the
# asset, not the whole repo (issue #139). The allow-listed archive surface
# is enforced by scripts/check-asset-archive.py (issue #158).
/.claude       export-ignore
/.cursor       export-ignore
/.devcontainer export-ignore
/.github       export-ignore
/.githooks     export-ignore
/.llm          export-ignore
/docs          export-ignore
/hooks         export-ignore
/overrides     export-ignore
/progress      export-ignore
/scripts       export-ignore
/tests         export-ignore
/.asset-template.json.hb export-ignore
/.cursorrules            export-ignore
/.env.example            export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.lychee.toml            export-ignore
/.markdownlint.json      export-ignore
/.markdownlint-cli2.jsonc export-ignore
/.mcp.json               export-ignore
/.pre-commit-config.yaml export-ignore
/.windsurfrules          export-ignore
/AGENTS.md               export-ignore
/CHATGPT.md              export-ignore
/CLAUDE.md               export-ignore
/CODEX.md                export-ignore
/GEMINI.md               export-ignore
/PLAN.md                 export-ignore
/export_presets.cfg      export-ignore
/gdlintrc                export-ignore
/llms.txt                export-ignore
/mkdocs.yml              export-ignore
/opencode.json           export-ignore
/requirements-automation.txt export-ignore
/requirements-ci.txt         export-ignore
/requirements-docs.txt   export-ignore
