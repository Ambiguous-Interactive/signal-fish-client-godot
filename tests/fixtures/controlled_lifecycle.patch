         assert!(!server.connect_token_required());
     }
 }
+
+pub fn godot_acceptance_take(name: &str) -> bool {
+    let Ok(dir) = std::env::var("SF_GODOT_BARRIER_DIR") else {
+        return false;
+    };
+    std::fs::remove_file(std::path::Path::new(&dir).join(format!("{name}.arm"))).is_ok()
+}
+
+pub fn godot_acceptance_mark(name: &str) {
+    let dir = std::env::var("SF_GODOT_BARRIER_DIR").unwrap();
+    std::fs::write(
+        std::path::Path::new(&dir).join(format!("{name}.reached")),
+        b"reached",
+    )
+    .unwrap();
+}
+
+pub async fn godot_acceptance_pause(name: &str) {
+    if !godot_acceptance_take(name) {
+        return;
+    }
+    godot_acceptance_mark(name);
+    let dir = std::env::var("SF_GODOT_BARRIER_DIR").unwrap();
+    let release = std::path::Path::new(&dir).join(format!("{name}.release"));
+    tokio::time::timeout(std::time::Duration::from_secs(15), async {
+        while !release.exists() {
+            tokio::time::sleep(std::time::Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .expect("Godot acceptance barrier was not released");
+}
