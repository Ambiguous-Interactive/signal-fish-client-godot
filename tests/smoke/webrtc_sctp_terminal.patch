+void SctpTransport::disconnect(const sctp_assoc_change *association) {
+	// A lower-transport EOF can race the association notification.
+	for (;;) {
+		const auto previous = state();
+		if (previous != State::Connecting && previous != State::Connected)
+			return;
+		const auto terminal = previous == State::Connected ? State::Disconnected : State::Failed;
+		if (!changeStateIf(previous, terminal))
+			continue;
+		if (terminal == State::Disconnected) {
+			PLOG_INFO << "SCTP disconnected";
+			recv(nullptr);
+		} else {
+			if (association) {
+				diagnostics::lifecycle("sctp_failure", 0, diagnosticId, 0, 0, int(previous), SCTP_ASSOC_CHANGE, association->sac_assoc_id, association->sac_state, association->sac_error);
+			}
+			PLOG_ERROR << "SCTP connection failed";
+		}
+		mWrittenCondition.notify_all();
+		return;
+	}
 }
 
