+bool Transport::changeStateIf(State expected, State desired) {
+	bool changed = false;
+	try {
+		mStateChangeCallback.callIf([&]() {
+			changed = mState.compare_exchange_strong(expected, desired);
+			return changed;
+		}, desired);
+	} catch (const std::exception &e) {
+		PLOG_WARNING << e.what();
+	}
+	return changed;
 }
 
